digraph RealityTree {
  graph [charset="UTF-8"];
  node [shape=box, style="filled,rounded"]; // Default style, individual nodes will override fillcolor
  edge [arrowhead=vee];

  // Node Definitions
  horizon_bugs [label="Horizon system had bugs,\nerrors, and defects.", style=filled, fillcolor=lightblue];
  horizon_shortfalls [label="Bugs/errors in Horizon caused\napparent shortfalls in branch accounts.", style=filled, fillcolor=lightblue];
  horizon_unreliable [label="Bugs/errors undermined Horizon's\nreliability for transaction processing.", style=filled, fillcolor=lightblue];
  legacy_horizon_not_robust [label="Legacy Horizon was not\nremotely robust.", style=filled, fillcolor=lightblue];
  remote_access_fujitsu [label="Fujitsu had remote access to alter\nbranch data without SPM knowledge/consent.", style=filled, fillcolor=lightblue];

  pol_knew_issues [label="POL/Fujitsu were aware of\nHorizon system issues & defects.", style=filled, fillcolor=lightgoldenrodyellow];
  pol_failed_disclosure_prosecutions [label="POL failed to disclose known Horizon\nissues to defendants during prosecutions.", style=filled, fillcolor=lightgoldenrodyellow];
  pol_failed_disclosure_spms [label="POL failed to adequately inform SPMs\nabout Horizon issues.", style=filled, fillcolor=lightgoldenrodyellow];

  pol_prosecutes_spms [label="POL initiated private prosecutions\nagainst SPMs based on Horizon data.", style=filled, fillcolor=lightcoral];
  reliance_on_horizon_data [label="Prosecutions relied heavily on the\npresumed accuracy of Horizon data.", style=filled, fillcolor=lightcoral];
  fujitsu_witness_infallibility [label="Fujitsu witness(es) asserted\nHorizon's infallibility in court.", style=filled, fillcolor=lightcoral];
  courts_accepted_horizon_evidence [label="Courts often accepted Horizon\nevidence as reliable.", style=filled, fillcolor=lightcoral];
  unjust_prosecutions [label="More successful prosecutions by POL\nthan would be just.", style=filled, fillcolor=lightcoral];

  ndas_suppressed_info [label="Use of NDAs by POL suppressed\ninformation about Horizon problems.", style=filled, fillcolor=dimgrey, fontcolor=white];
  failed_prosecutions_buried_ndas [label="Early prosecution failures potentially\nburied by NDAs.", style=filled, fillcolor=dimgrey, fontcolor=white];

  defense_did_not_challenge_horizon [label="Defence teams often did not effectively\nchallenge Horizon's reliability.", style=filled, fillcolor=lightpink];
  dba_experts_not_used [label="Database/IT experts were not (or inadequately)\nutilized by defence teams.", style=filled, fillcolor=lightpink];
  limited_data_access_spms [label="SPMs had limited access to transaction\ndata to identify causes of shortfalls.", style=filled, fillcolor=lightpink];

  spms_accused_of_shortfalls [label="SPMs accused of financial\nshortfalls shown by Horizon.", style=filled, fillcolor=green];
  spms_contractual_liability [label="SPMs held contractually liable for\nHorizon-generated shortfalls.", style=filled, fillcolor=green];
  wrongful_convictions [label="Wrongful convictions of\nSPMs occurred.", style=filled, fillcolor=green];

  // Relationships (Effect -> Cause)
  horizon_shortfalls -> horizon_bugs;
  horizon_shortfalls -> remote_access_fujitsu;
  horizon_unreliable -> horizon_bugs;
  pol_prosecutes_spms -> horizon_shortfalls;
  pol_prosecutes_spms -> spms_contractual_liability;
  spms_accused_of_shortfalls -> horizon_shortfalls;
  reliance_on_horizon_data -> pol_knew_issues;
  reliance_on_horizon_data -> fujitsu_witness_infallibility;
  reliance_on_horizon_data -> courts_accepted_horizon_evidence;
  courts_accepted_horizon_evidence -> fujitsu_witness_infallibility;
  courts_accepted_horizon_evidence -> defense_did_not_challenge_horizon;
  pol_failed_disclosure_prosecutions -> pol_knew_issues;
  defense_did_not_challenge_horizon -> pol_failed_disclosure_prosecutions;
  defense_did_not_challenge_horizon -> dba_experts_not_used;
  dba_experts_not_used -> pol_failed_disclosure_prosecutions;
  fujitsu_witness_infallibility -> pol_knew_issues;
  unjust_prosecutions -> reliance_on_horizon_data;
  unjust_prosecutions -> pol_failed_disclosure_prosecutions;
  unjust_prosecutions -> failed_prosecutions_buried_ndas;
  failed_prosecutions_buried_ndas -> ndas_suppressed_info;
  ndas_suppressed_info -> pol_knew_issues;
  wrongful_convictions -> unjust_prosecutions;
  wrongful_convictions -> courts_accepted_horizon_evidence;
  spms_accused_of_shortfalls -> limited_data_access_spms;

  // Additional relationships based on context (optional but good for completeness)
  legacy_horizon_not_robust -> horizon_bugs;
  pol_knew_issues -> horizon_bugs;
  pol_knew_issues -> remote_access_fujitsu;
  // Relationship for the newly uncommented node - assuming it's a cause for defense challenges
  defense_did_not_challenge_horizon -> pol_failed_disclosure_spms;

  subgraph cluster_legend {
    label = "Acronym Key";
    node [style=filled, fillcolor=lightyellow, shape=plaintext]; // Default style for legend block
    legend_key [label="Acronym Key:\n\nSPM: SubPostmaster\nPOL: Post Office Limited\nNDA: Non-Disclosure Agreement\nDBA: Database Administrator\nKELs: Known Error Logs (Fujitsu)\nPEAKs: Problem Event And Known error (Fujitsu)\nHNG-X: Horizon Next Gen - X\nHNG-A: Horizon Next Gen - A", style=filled, fillcolor=lightyellow, shape=plaintext];
  }
}
